---
import Layout from '../../layouts/Layout.astro';
const posts = await Astro.glob('../../content/blog/*.md');

const siteTitle = "Urban Food Finds Blog";
const siteDescription = "Latest articles about food trends and local restaurants.";
---

<Layout title={siteTitle} description={siteDescription}>
	<section class="py-8">
		<h1 class="text-3xl font-urban-title font-semibold mb-6">{siteTitle}</h1>
		<p class="text-gray-700 mb-4">{siteDescription}</p>
		<ul>
			{posts.map((post) => (
				<li class="mb-4">
					<a href={post.url} class="text-urban-primary hover:text-urban-secondary">
						<h2 class="text-xl font-semibold">{post.frontmatter.title}</h2>
					</a>
					<p class="text-sm text-gray-500">Published: {new Date(post.frontmatter.pubDate).toLocaleDateString()}</p>
					<p class="text-gray-700">{post.frontmatter.description}</p>
				</li>
			))}
		</ul>
	</section>
</Layout>